# ===================================================
# CAMPUS CLUB EXPLORER — FRONTEND ENVIRONMENT VARIABLES
# ===================================================

# Express Backend API URL (Proxied via Vite dev server or direct production endpoint)
VITE_API_URL=/api

# Supabase Client Configuration (Public Anon Key ONLY)
# Obtain from your Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# NOTE: NEVER add SUPABASE_SERVICE_ROLE_KEY to frontend environment variables.
# Vite prefixes with VITE_ are bundled into client-side JavaScript.
