# ===================================================
# CAMPUS CLUB EXPLORER — BACKEND ENVIRONMENT VARIABLES
# ===================================================

PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Security: JWT Signing Secret
# In production, generate a secure 256-bit secret using: openssl rand -hex 32
JWT_SECRET=your-secure-random-256-bit-jwt-secret

# Storage Mode: 'supabase' (enforces cloud database with no fallback) or 'memory' (local dev fallback)
STORAGE_MODE=supabase

# Supabase PostgreSQL & Auth Credentials
# Obtain from your Supabase Project Dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
# Public anon key (safe for browser & RLS requests)
SUPABASE_ANON_KEY=your-supabase-anon-key
# Private service-role key (SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
